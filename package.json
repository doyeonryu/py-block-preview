{
  "name": "py-block-preview",
  "displayName": "Python Block Preview",
  "description": "See the structure of Python code at a glance — functions, classes, call relationships and control flow as live-synced cards beside your editor.",
  "version": "0.1.1",
  "publisher": "doyeonryu",
  "author": "doyeonryu",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/doyeonryu/py-block-preview.git"
  },
  "bugs": {
    "url": "https://github.com/doyeonryu/py-block-preview/issues"
  },
  "homepage": "https://github.com/doyeonryu/py-block-preview#readme",
  "keywords": [
    "python",
    "visualization",
    "code structure",
    "call graph",
    "outline",
    "preview",
    "code review",
    "ai"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pyBlockPreview.openToSide",
        "title": "Open Block Preview to the Side",
        "category": "Python Block Preview",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pyBlockPreview.openToSide",
          "when": "editorLangId == python",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pyBlockPreview.openToSide",
          "when": "editorLangId == python"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pyBlockPreview.openToSide",
        "key": "ctrl+k b",
        "mac": "cmd+k b",
        "when": "editorLangId == python"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs && node --test out/test/",
    "inspect": "node esbuild.mjs && node out/inspect.js",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "install-ext": "npm run package && node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "tree-sitter-python": "^0.23.0",
    "typescript": "^5.6.0",
    "web-tree-sitter": "^0.24.0"
  }
}
